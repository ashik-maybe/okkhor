{
  "name": "okkhor",
  "version": "0.1.0",
  "private": true,
  "description": "Okkhor is a private, offline Bangla writing studio with a modern phonetic keyboard.",
  "license": "MIT",
  "author": "Ashik",
  "repository": "git://github.com/ashik-maybe/okkhor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "bun tests/e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/anek-bangla": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.544.0",
    "minisearch": "^7.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
